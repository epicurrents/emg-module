{
  "name": "@epicurrents/emg-module",
  "version": "0.0.1",
  "description": "Epicurrents EMG module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": "./dist/config/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./types": "./dist/types/index.d.ts",
    "./package.json": "./package.json",
    "./dist/config": "./dist/config/index.js",
    "./dist/runtime": "./dist/runtime/index.js",
    "./dist/types": "./dist/types/index.d.ts"
  },
  "files": [
    "dist/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:tsc",
    "build:lib": "vite build",
    "build:tsc": "npm run build:lib && npm run build:types",
    "build:types": "epicurrents-build-types",
    "lint": "npm run lint:src",
    "lint:src": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epicurrents/emg-module.git"
  },
  "author": "Sampsa Lohi",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@epicurrents/core": "^1.0.0",
    "@eslint/js": "^9.18.0",
    "@microsoft/tsdoc": "^0.14.1",
    "dotenv": "^16.3.1",
    "eslint": "^9.18.0",
    "scoped-event-log": "^3.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@epicurrents/core": "^1.0.0",
    "scoped-event-log": "^3.2.0"
  }
}
